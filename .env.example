APP_ENV=local
ALLOWED_ORIGINS=https://localhost:3000,http://localhost:3000
REQUEST_TIMEOUT_SECONDS=45
MAX_INPUT_CHARS=8000
# GroqCloud Chat Completions base URL.
GROQ_API_BASE_URL=https://api.groq.com/openai/v1
# Server-side Groq API key. The API holds this in its own .env and uses it
# to call GroqCloud on behalf of all clients. Clients no longer need to
# send their own key in the request body.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_replace_with_your_real_key
